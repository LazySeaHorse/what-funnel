# ===========================================================================
# WhatFunnel Production Environment Configuration Template
# ===========================================================================
# Copy this file to .env before starting the production stack:
#   cp .env.example .env
#
# IMPORTANT:
# - Generate high-entropy random secrets before deploying to production.
# - Do not commit .env to version control.
# ===========================================================================

# Runtime Environment
APP_ENV=production
ENV=production
ENVIRONMENT=production
LOG_LEVEL=info
PORT=8080
WEB_PORT=80
ALLOWED_ORIGINS=https://app.whatfunnel.com,https://whatfunnel.com
COOKIE_SECURE=true
# Simulation/internal test routes are opt-in. Keep false in production.
ENABLE_SIMULATION_ROUTES=false
# Private listener for Prometheus /metrics (never publish this port).
# Optional; shown with its default:
# METRICS_ADDR=:9090

# Database (PostgreSQL with pgvector)
POSTGRES_USER=whatfunnel
POSTGRES_PASSWORD=replace-with-a-secure-database-password
POSTGRES_DB=whatfunnel
DATABASE_URL=postgres://whatfunnel:replace-with-a-secure-database-password@postgres:5432/whatfunnel?sslmode=disable
DB_POOL_MAX_CONNS=25
DB_PGBOUNCER=false

# Redis Event Bus & Cache
REDIS_URL=redis://redis:6379

# Application Secrets
# SESSION_SECRET: Minimum 32 characters for HMAC signing of auth session cookies
# Generate: openssl rand -base64 32
SESSION_SECRET=replace-with-a-secure-session-secret-at-least-32-chars
# SESSION_PURGE_INTERVAL: Interval between background cleanups of expired sessions (default: 1h)
SESSION_PURGE_INTERVAL=1h

# ENCRYPTION_KEY: 32-byte (64 hex characters) AES-256 key for sensitive stored credentials.
# REQUIRED, no default: generate one and keep it safe (losing it makes stored
# credentials unreadable; changing it invalidates them).
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# Internal adapter & service authentication (never expose to browsers)
# INTERNAL_SERVICE_TOKEN is mandatory (min 32 characters) and has no fallback.
# Generate: openssl rand -base64 32
ADAPTER_SHARED_SECRET=replace-with-a-secure-adapter-shared-secret
INTERNAL_SERVICE_TOKEN=replace-with-a-secure-internal-service-token-at-least-32-chars

# Internal Microservice Routing
IDENTITY_SVC_URL=http://identity-svc:8081
WHATSAPP_ADAPTER_URL=http://whatsapp-adapter:8086
TELEGRAM_ADAPTER_URL=http://telegram-adapter:8087
TELEGRAM_BOT_API_URL=https://api.telegram.org

# Media & Attachment Storage (S3 / MinIO / Local Disk)
# "disk" (default, matches docker-compose.prod.yml) stores media on a volume.
# Set to "s3" to use the bundled MinIO service (or any S3-compatible store).
MEDIA_STORAGE_BACKEND=disk
MEDIA_CACHE_PATH=/tmp/whatfunnel-media
MEDIA_S3_ENDPOINT=minio:9000
MEDIA_S3_BUCKET=whatfunnel-media
# The bundled MinIO service is initialised from MINIO_ROOT_USER/PASSWORD (both
# required by docker-compose.prod.yml, no defaults), and the conversation
# service uses the same credentials for S3 unless MEDIA_S3_ACCESS_KEY /
# MEDIA_S3_SECRET_KEY are set to override them (e.g. for an external S3 store).
MINIO_ROOT_USER=whatfunnel
MINIO_ROOT_PASSWORD=replace-with-minio-root-password
MEDIA_S3_ACCESS_KEY=
MEDIA_S3_SECRET_KEY=
MEDIA_S3_REGION=us-east-1
MEDIA_S3_USE_SSL=false

# AI Knowledge Base Compiler & Answer Engine
GOOGLE_AI_KEY=replace-with-google-ai-api-key
MINING_INTERVAL_HOURS=6
# Optional: integer seed for the UI monkey fuzz suites (default is a fixed
# constant printed at the start of each run). Leave unset for the default.
# Note: the fuzzers parse this as an integer; "0" is a valid seed.
FUZZ_SEED=

# ---------------------------------------------------------------------------
# Optional tuning (commented out = built-in default shown)
# ---------------------------------------------------------------------------
# DEV ONLY: allow weak/missing internal auth tokens. Ignored when APP_ENV=production.
# ALLOW_INSECURE_INTERNAL_AUTH=false
# Per-attempt provider timeout for ai-answer-svc (default 20) and attempts per call (default 2)
# AI_REQUEST_TIMEOUT_SECONDS=20
# AI_PROVIDER_MAX_ATTEMPTS=2
# Debounce windows in seconds: first bubble / second bubble / third+ bubbles (defaults 4 / 4 / 6)
# AI_DEBOUNCE_FIRST_SECONDS=4.0
# AI_DEBOUNCE_SUBSEQUENT_SECONDS=4.0
# AI_DEBOUNCE_BURST_SECONDS=6.0
# Seconds after which a stuck AI run is reclaimed (default: 3*AI_PROVIDER_MAX_ATTEMPTS*AI_REQUEST_TIMEOUT_SECONDS+30)
# AI_RUN_RECLAIM_SECONDS=
# Max concurrent AI cascade runs per ai-answer-svc instance
# AI_CASCADE_CONCURRENCY=8
# Max attempts for a debounced AI run before the conversation is flagged for human review
# AI_DEBOUNCE_MAX_ATTEMPTS=3
# Max redeliveries of a stream message before it is dead-lettered
# STREAM_MAX_DELIVERIES=5
# conversation-svc: log out adapter sessions that have no channel in the database.
# Unpairs WhatsApp phones irreversibly, so it is off by default.
# ADAPTER_ORPHAN_EVICTION=false
# Minimum age of an orphaned adapter session before it may be evicted (Go duration)
# ADAPTER_ORPHAN_EVICTION_GRACE=6h

# ---------------------------------------------------------------------------
# AI router evaluation harness (services/ai-answer-svc/eval, `make eval-router`). Offline tool only.
# ---------------------------------------------------------------------------
# OpenAI-compatible base URL and key of the endpoint to evaluate, and the model name
# EVAL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# EVAL_API_KEY=
# EVAL_MODEL=gemini-3.1-flash-lite
# Optional: per-attempt timeout seconds, attempts per call, parallel calls, sleep after each call (rate limits)
# EVAL_TIMEOUT=30
# EVAL_MAX_ATTEMPTS=2
# EVAL_CONCURRENCY=4
# EVAL_MIN_INTERVAL=0
# Optional: JSONL replay cache path, and USD per 1M tokens for the cost estimate
# EVAL_CACHE=
# EVAL_PRICE_IN=
# EVAL_PRICE_OUT=
