# ===========================================================================
# WhatFunnel Production Environment Configuration Template
# ===========================================================================
# Copy this file to .env before starting the production stack:
#   cp .env.example .env
#
# IMPORTANT:
# - Generate high-entropy random secrets before deploying to production.
# - Do not commit .env to version control.
# ===========================================================================

# Runtime Environment
APP_ENV=production
ENV=production
ENVIRONMENT=production
LOG_LEVEL=info
PORT=8080
WEB_PORT=80
ALLOWED_ORIGINS=https://app.whatfunnel.com,https://whatfunnel.com
COOKIE_SECURE=true
ENABLE_SIMULATION_ROUTES=false

# Database (PostgreSQL with pgvector)
POSTGRES_USER=whatfunnel
POSTGRES_PASSWORD=replace-with-a-secure-database-password
POSTGRES_DB=whatfunnel
DATABASE_URL=postgres://whatfunnel:replace-with-a-secure-database-password@postgres:5432/whatfunnel?sslmode=disable
DB_POOL_MAX_CONNS=25
DB_PGBOUNCER=false

# Redis Event Bus & Cache
REDIS_URL=redis://redis:6379

# Application Secrets
# SESSION_SECRET: Minimum 32 characters for HMAC signing of auth session cookies
# Generate: openssl rand -base64 32
SESSION_SECRET=replace-with-a-secure-session-secret-at-least-32-chars

# ENCRYPTION_KEY: 32-byte (64 hex characters) AES-256 key for sensitive stored credentials
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=replace-with-a-secure-64-character-hex-encryption-key-for-aes256

# Internal adapter & service authentication (never expose to browsers)
# Generate: openssl rand -base64 32
ADAPTER_SHARED_SECRET=replace-with-a-secure-adapter-shared-secret
INTERNAL_SERVICE_TOKEN=replace-with-a-secure-internal-service-token

# Internal Microservice Routing
IDENTITY_SVC_URL=http://identity-svc:8081
WHATSAPP_ADAPTER_URL=http://whatsapp-adapter:8086
TELEGRAM_ADAPTER_URL=http://telegram-adapter:8087
TELEGRAM_BOT_API_URL=https://api.telegram.org

# Media & Attachment Storage (S3 / MinIO / Local Disk)
MEDIA_STORAGE_BACKEND=s3
MEDIA_CACHE_PATH=/tmp/whatfunnel-media
MEDIA_S3_ENDPOINT=http://minio:9000
MEDIA_S3_BUCKET=whatfunnel-media
MEDIA_S3_ACCESS_KEY=replace-with-s3-access-key
MEDIA_S3_SECRET_KEY=replace-with-s3-secret-key
MEDIA_S3_REGION=us-east-1
MEDIA_S3_USE_SSL=false
MINIO_ROOT_USER=whatfunnel
MINIO_ROOT_PASSWORD=replace-with-minio-root-password

# AI Knowledge Base Compiler & Answer Engine
GOOGLE_AI_KEY=replace-with-google-ai-api-key
MINING_INTERVAL_HOURS=6
FUZZ_SEED=0
